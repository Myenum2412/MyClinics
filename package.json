{
  "name": "myclinics",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,green \"npm run dev -w @myclinics/backend\" \"npm run dev -w frontend\"",
    "build": "npm run build -w frontend",
    "start": "concurrently -k -n api,web -c blue,green \"npm run start -w @myclinics/backend\" \"npm run start -w frontend\"",
    "lint": "npm run lint -w frontend",
    "test": "npm run test -w @myclinics/backend",
    "typecheck": "npm run typecheck -w @myclinics/backend",
    "whatsapp": "npm run whatsapp -w @myclinics/backend"
  },
  "devDependencies": {
    "concurrently": "^9.2.0"
  },
  "dependencies": {
    "indiapins": "https://github.com/paramadeep/indiapins/releases/download/v2026.6.28/indiapins-2026.6.28.tgz"
  }
}

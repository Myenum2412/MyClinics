# Shared by all three processes (frontend dev server, API server, WhatsApp worker).
# Copy to .env.local (frontend/ next to the Next app, or the repo root) and fill in.

# MongoDB connection string (the API server and dashboard share the "myclinic" database)
MONGODB_URI=mongodb://localhost:27017

# NextAuth v5 (frontend) + API auth plugin (backend) verify the same JWE cookie with this secret
AUTH_SECRET=generate-with: npx auth secret

# Optional. If unset, the frontend proxies /api/* to http://localhost:3100
BACKEND_URL=http://localhost:3100

# Optional. API server port (default 3100) and bind host (default 0.0.0.0)
BACKEND_PORT=3100
BACKEND_HOST=0.0.0.0

# Default organization + staff user seeded on first start
ORG_NAME=My Clinic
ORG_DEFAULT_EMAIL=admin@example.com
ORG_DEFAULT_PASSWORD=change-me

# AI surface (nvidia AI Playground / deepseek). Required for AI endpoints + embeddings
AI_API_KEY=
AI_INTERNAL_TOKEN=change-me-shared-token

# WhatsApp worker (whatsapp-web.js)
WHATSAPP_SESSION_PATH=./whatsapp-session

# Optional. Lets the worker reach the AI endpoints via a public URL instead of localhost
APP_URL=

# Optional. R2 report storage (falls back to local disk under ./reports-data)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=

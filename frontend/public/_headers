# Cloudflare Edge Headers
/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  X-DNS-Prefetch-Control: off
  Cross-Origin-Opener-Policy: same-origin
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' https://*.myenum.in https://www.googletagmanager.com https://www.google-analytics.com https://*.googletagmanager.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://rsms.me; img-src 'self' data: https: blob: https://www.googletagmanager.com https://www.google-analytics.com; media-src 'self' https: data: blob:; frame-src 'self' https:; font-src 'self' data: https://fonts.gstatic.com https://rsms.me; connect-src 'self' https://api.myclinic.myenum.in https://*.myenum.in https://www.googletagmanager.com https://www.google-analytics.com https://*.google-analytics.com https://region1.google-analytics.com; frame-ancestors 'none'; object-src 'none'; base-uri 'self'; form-action 'self'

# Block crawling / indexing of internals
/_next/*
  X-Robots-Tag: noindex, nofollow

/api/*
  X-Robots-Tag: noindex, nofollow

# No store on source maps
/*.map
  Cache-Control: no-store
  X-Robots-Tag: noindex

# Favicons and webmanifest cache revalidation
/favicon.ico
  Cache-Control: public, max-age=0, must-revalidate

/favicon.svg
  Cache-Control: public, max-age=0, must-revalidate

/favicon-96x96.png
  Cache-Control: public, max-age=0, must-revalidate

/manifest.webmanifest
  Cache-Control: public, max-age=0, must-revalidate
